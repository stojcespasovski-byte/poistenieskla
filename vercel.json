{
  "rewrites": [
    { "source": "/app", "destination": "/poistenieskla.html" },
    { "source": "/dokumenty/:path*", "destination": "https://alexapi.sk/docs/:path*" },
    { "source": "/api/:path*", "destination": "https://alexapi.sk/:path*" },
    { "source": "/", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
