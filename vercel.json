{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/letak",
      "destination": "/letak.html"
    },
    {
      "source": "/letak/:kod",
      "destination": "/letak.html?p=:kod"
    },
    {
      "source": "/c/:kod",
      "destination": "/cakaren.html?p=:kod"
    },
    {
      "source": "/capi/:path*",
      "destination": "/api/capi?cesta=:path*"
    },
    {
      "source": "/dokumenty/:path*",
      "destination": "https://alexapi.sk/docs/:path*"
    },
    {
      "source": "/api/((?!capi/).*)",
      "destination": "https://alexapi.sk/$1"
    },
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/:kod([a-z0-9][a-z0-9-]{2,39})",
      "destination": "/cakaren.html?p=:kod"
    }
  ],
  "redirects": [
    {
      "source": "/poistenieskla.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
